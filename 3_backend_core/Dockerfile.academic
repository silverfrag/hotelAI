FROM node:24-alpine AS build
WORKDIR /app
COPY package*.json ./
COPY scripts/patch-kafkajs-request-queue.cjs ./scripts/
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
COPY scripts/patch-kafkajs-request-queue.cjs scripts/academic-demo-server.cjs ./scripts/
RUN npm ci --omit=dev
COPY --chown=node:node --from=build /app/dist ./dist
USER node
EXPOSE 3000
CMD ["node", "scripts/academic-demo-server.cjs"]
