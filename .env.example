POSTGRES_DB=hotel_db
DEPLOYMENT_MODE=development
# Production: provision a separate LOGIN, GRANT hotelai_runtime, and use it here.
BACKEND_DB_USER=
BACKEND_DB_PASSWORD=
POSTGRES_USER=hotel_admin
POSTGRES_PASSWORD=change-me
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=1500
ROOM_CATALOG_CACHE_TTL_SECONDS=300
KAFKA_BIND_ADDRESS=127.0.0.1
KAFKA_PORT=9092
KAFKA_EXTERNAL_HOST=localhost
HOTEL_TIMEZONE=Asia/Bangkok
CORS_ORIGINS=http://localhost,http://localhost:3000
COOKIE_SECURE=false
AI_SERVICE_TIMEOUT_MS=5000
AI_SHADOW_OPTIMIZER_URL=http://localhost:8000/api/v1/optimize-price-shadow
AI_SHADOW_TIMEOUT_MS=750
PRICING_QUOTE_TTL_SECONDS=900
JWT_SECRET=
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=hotel-backend-core
KAFKA_DOMAIN_EVENTS_TOPIC=hotel.domain-events.v1
KAFKA_TOPIC_PARTITIONS=1
KAFKA_TOPIC_REPLICATION_FACTOR=1
KAFKA_CONNECTION_TIMEOUT_MS=2000
KAFKA_REQUEST_TIMEOUT_MS=5000
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
BOOKING_EXPIRY_POLL_MS=15000
