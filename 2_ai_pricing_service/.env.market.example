# Set these variables in the Python service process. No key is needed for the
# default public-source collection. Never put provider keys in NEXT_PUBLIC_*.
# Optional operator-controlled JSON registry of public HTTPS sources.
# MARKET_SOURCES_PATH=E:/hotelAI/2_ai_pricing_service/data/danang_sources.json
MARKET_EVIDENCE_DIR=.tmp/market-evidence
MARKET_DECISIONS_DIR=.tmp/market-decisions
# A NEW trained context-conversion artifact; not the old synthetic challenger.
MARKET_CONVERSION_MODEL_DIR=app/models/danang_market_v1
# Optional hosted model implementing the chat-completions JSON contract.
# Configure a provider/model you have access to; no model name is assumed.
MARKET_CONTEXT_COMPLETIONS_URL=
MARKET_CONTEXT_MODEL=
MARKET_CONTEXT_API_KEY=
# Local option (set these in the Python process; no API key):
# MARKET_CONTEXT_PROVIDER=ollama
# MARKET_CONTEXT_MODEL=qwen3:1.7b
# MARKET_CONTEXT_OLLAMA_URL=http://127.0.0.1:11434/api/chat
