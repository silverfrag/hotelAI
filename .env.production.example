# ==============================================================================
# Hotel AI - Production Environment Configuration
# Copy this file to .env.production on the production host / server.
# NEVER commit .env.production into source control.
# ==============================================================================

# Domain registered by the project owner. Point its A record to the VPS first.
PUBLIC_DOMAIN=whitesandhotel.dev
PUBLIC_BIND_ADDRESS=0.0.0.0

# Caddy owns public 80/443 with automated TLS; gateway stays local on 127.0.0.1:8080.
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_PORT=8080

DEPLOYMENT_MODE=production
COOKIE_SECURE=true
CORS_ORIGINS=https://whitesandhotel.dev
HOTEL_TIMEZONE=Asia/Bangkok

# Database administrative credentials (used for initial setup and migrations)
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_ADMIN_PASSWORD
BACKEND_DB_USER=hotelai_app
BACKEND_DB_PASSWORD=CHANGE_THIS_RUNTIME_DATABASE_PASSWORD

# Security secret (generate with: openssl rand -hex 32)
JWT_SECRET=CHANGE_THIS_TO_AT_LEAST_32_RANDOM_BYTES

# State stores are bound to loopback only (never exposed directly to public internet)
POSTGRES_BIND_ADDRESS=127.0.0.1
REDIS_BIND_ADDRESS=127.0.0.1
KAFKA_BIND_ADDRESS=127.0.0.1
