# Private core API target for server rendering and the same-origin browser API.
# Native frontend: npm run dev -- --port 3100
BACKEND_API_URL=http://localhost:3000/api/v1/core
# Optional: use http://localhost/api/v1/core when the existing Docker gateway runs.
# NEXT_PUBLIC_API_URL is normally omitted; browser requests use /api/v1/core.
